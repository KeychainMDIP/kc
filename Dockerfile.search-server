# syntax=docker/dockerfile:1

FROM node:22.15.0-bullseye-slim AS builder

RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY services/search-server/package*.json ./search-server/

RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
RUN --mount=type=cache,target=/root/.npm cd search-server && npm ci

COPY services/search-server ./search-server/

RUN npm rebuild sqlite3
RUN npm run build
RUN cd search-server && npm run build

FROM node:22.15.0-bullseye-slim

WORKDIR /app
COPY --from=builder /app /app
RUN chown -R node:node /app/search-server

USER node
WORKDIR /app/search-server

EXPOSE 4002

CMD ["node", "dist/index.js"]
