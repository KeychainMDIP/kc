{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MDIP Hyperswarm wire protocol v2 message",
  "oneOf": [
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/queue" },
    { "$ref": "#/$defs/orderedCatchupReq" },
    { "$ref": "#/$defs/orderedCatchupPush" },
    { "$ref": "#/$defs/orderedCatchupDone" },
    { "$ref": "#/$defs/negOpen" },
    { "$ref": "#/$defs/negMsg" },
    { "$ref": "#/$defs/opsOffer" },
    { "$ref": "#/$defs/opsReq" },
    { "$ref": "#/$defs/opsPush" },
    { "$ref": "#/$defs/opsAck" },
    { "$ref": "#/$defs/negClose" }
  ],
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "syncId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "operation": {
      "type": "object"
    },
    "operationPage": {
      "type": "array",
      "maxItems": 300,
      "items": { "$ref": "#/$defs/operation" }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syncOrder", "id"],
      "properties": {
        "syncOrder": { "$ref": "#/$defs/safeInteger" },
        "id": { "$ref": "#/$defs/syncId" }
      }
    },
    "windowCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ts", "id"],
      "properties": {
        "ts": { "$ref": "#/$defs/safeInteger" },
        "id": { "$ref": "#/$defs/syncId" }
      }
    },
    "continuation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/windowCursor" }
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["until", "limit"],
      "properties": {
        "until": {
          "type": "integer",
          "minimum": 1704067200,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25000
        },
        "after": { "$ref": "#/$defs/windowCursor" }
      }
    },
    "frame": {
      "type": "string",
      "minLength": 4,
      "maxLength": 174764,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "ping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": { "const": "ping" },
        "version": { "const": 2 },
        "name": { "type": "string" },
        "peerDids": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string" }
        },
        "latestTs": { "$ref": "#/$defs/safeInteger" },
        "ordered": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "sourceReady"],
          "properties": {
            "count": { "$ref": "#/$defs/safeInteger" },
            "sourceReady": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": {
                "required": ["sourceReady"],
                "properties": { "sourceReady": { "const": true } }
              },
              "then": {
                "properties": { "count": { "$ref": "#/$defs/positiveSafeInteger" } }
              }
            }
          ]
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operations"],
      "properties": {
        "type": { "const": "queue" },
        "operations": { "$ref": "#/$defs/operationPage" }
      }
    },
    "orderedCatchupReq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionId"],
      "properties": {
        "type": { "const": "ordered_catchup_req" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "after": { "$ref": "#/$defs/cursor" }
      }
    },
    "orderedCatchupPush": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionId", "cursor", "hasMore", "operations"],
      "properties": {
        "type": { "const": "ordered_catchup_push" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "cursor": { "$ref": "#/$defs/cursor" },
        "hasMore": { "type": "boolean" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 300,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "orderedCatchupDone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionId"],
      "properties": {
        "type": { "const": "ordered_catchup_done" },
        "sessionId": { "$ref": "#/$defs/sessionId" }
      }
    },
    "negOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionId", "windowSeq", "window", "round", "frame"],
      "properties": {
        "type": { "const": "neg_open" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "windowSeq": { "$ref": "#/$defs/safeInteger" },
        "window": { "$ref": "#/$defs/window" },
        "round": { "$ref": "#/$defs/safeInteger" },
        "frame": { "$ref": "#/$defs/frame" },
        "previousContinuation": { "$ref": "#/$defs/continuation" }
      }
    },
    "negMsg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionId", "windowSeq", "round", "frame", "continuation"],
      "properties": {
        "type": { "const": "neg_msg" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "windowSeq": { "$ref": "#/$defs/safeInteger" },
        "round": { "$ref": "#/$defs/safeInteger" },
        "frame": { "$ref": "#/$defs/frame" },
        "continuation": { "$ref": "#/$defs/continuation" }
      }
    },
    "opsOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionId", "transferId", "ids"],
      "properties": {
        "type": { "const": "ops_offer" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "transferId": { "$ref": "#/$defs/safeInteger" },
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/syncId" }
        }
      }
    },
    "opsReq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionId", "transferId", "ids"],
      "properties": {
        "type": { "const": "ops_req" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "transferId": { "$ref": "#/$defs/safeInteger" },
        "ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/syncId" }
        },
        "incomplete": { "const": true }
      }
    },
    "opsPush": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionId", "transferId", "page", "hasMore", "operations"],
      "properties": {
        "type": { "const": "ops_push" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "transferId": { "$ref": "#/$defs/safeInteger" },
        "page": { "$ref": "#/$defs/safeInteger" },
        "hasMore": { "type": "boolean" },
        "operations": { "$ref": "#/$defs/operationPage" }
      },
      "allOf": [
        {
          "if": {
            "required": ["hasMore"],
            "properties": { "hasMore": { "const": true } }
          },
          "then": {
            "properties": { "operations": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    },
    "opsAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionId", "transferId", "page"],
      "properties": {
        "type": { "const": "ops_ack" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "transferId": { "$ref": "#/$defs/safeInteger" },
        "page": { "$ref": "#/$defs/safeInteger" },
        "incomplete": { "const": true }
      }
    },
    "negClose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionId", "windowSeq", "round", "outcome"],
      "properties": {
        "type": { "const": "neg_close" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "windowSeq": { "$ref": "#/$defs/safeInteger" },
        "round": { "$ref": "#/$defs/safeInteger" },
        "outcome": {
          "enum": ["complete", "busy", "round_limit", "incomplete"]
        },
        "continuation": { "$ref": "#/$defs/continuation" }
      },
      "allOf": [
        {
          "if": {
            "required": ["outcome"],
            "properties": {
              "outcome": { "enum": ["complete", "round_limit"] }
            }
          },
          "then": {
            "required": ["continuation"],
            "properties": {
              "continuation": { "$ref": "#/$defs/continuation" }
            }
          }
        }
      ]
    }
  }
}
