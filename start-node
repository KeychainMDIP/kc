#!/usr/bin/env bash
set -e

PROFILE_ARGS=()
SERVICES=()
RESET_DB=false
RESET_DB_COUNT=0

for ARG in "$@"; do
    if [ "$ARG" = "--reset-db" ]; then
        RESET_DB=true
        RESET_DB_COUNT=$((RESET_DB_COUNT + 1))
    else
        SERVICES+=("$ARG")
    fi
done

if [ "$RESET_DB_COUNT" -gt 1 ]; then
    echo "Error: --reset-db may be specified only once" >&2
    exit 2
fi

if [ "$RESET_DB" = true ] && [ ${#SERVICES[@]} -gt 0 ]; then
    if ! printf '%s\n' "${SERVICES[@]}" | grep -qx "search-server"; then
        echo "Error: --reset-db requires search-server in the service list" >&2
        exit 2
    fi
fi

if [ -f .env ]; then
    set -a
    # shellcheck disable=SC1091
    . ./.env
    set +a
fi

KC_IPFS_ENABLE_LC="$(printf '%s' "${KC_IPFS_ENABLE:-}" | tr '[:upper:]' '[:lower:]')"

if [ "$KC_IPFS_ENABLE_LC" != "false" ]; then
    PROFILE_ARGS=(--profile ipfs)
fi

if [ ${#SERVICES[@]} -gt 0 ] && [ "$KC_IPFS_ENABLE_LC" != "false" ]; then
    if ! printf '%s\n' "${SERVICES[@]}" | grep -qx "ipfs"; then
        SERVICES=("ipfs" "${SERVICES[@]}")
    fi
fi

docker compose --profile ipfs down
docker compose down
docker compose "${PROFILE_ARGS[@]}" build "${SERVICES[@]}"
if [ "$RESET_DB" = true ]; then
    KC_SEARCH_SERVER_RESET_DB=true docker compose "${PROFILE_ARGS[@]}" up "${SERVICES[@]}"
else
    docker compose "${PROFILE_ARGS[@]}" up "${SERVICES[@]}"
fi
